{
  "name": "daily-hisab",
  "version": "1.0.0",
  "description": "Daily Hisab desktop app for expenses, investments, loans/EMIs, and salary tracking",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:linux": "npm run build && electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.dailyhisab.app",
    "productName": "Daily Hisab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "google-auth.html",
      "preload.js",
      "preload.cjs",
      ".env",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.png",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    }
  },
  "keywords": [
    "personal-finance",
    "expense-tracker",
    "hisab",
    "loans",
    "emi",
    "investments",
    "salary",
    "desktop-app"
  ],
  "author": {
    "name": "Sourav Mahanty",
    "email": "souravmahanty12@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.3.0"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "firebase": "^12.17.0",
    "lucide": "^0.395.0"
  }
}
