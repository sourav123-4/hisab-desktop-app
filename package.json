{
  "name": "daily-hisab",
  "version": "1.4.0",
  "description": "Daily Hisab desktop app for expenses, investments, loans/EMIs, and salary tracking",
  "desktopName": "daily-hisab",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/start-electron.cjs",
    "debug": "node scripts/start-electron.cjs --open-devtools",
    "test": "tsx src/js/store.test.ts",
    "test:ui": "playwright test",
    "rephrase-entries": "tsx scripts/rephrase_entries.ts",
    "dist": "npm run build && electron-builder",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:linux": "npm run build && electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.dailyhisab.app",
    "productName": "Daily Hisab",
    "publish": [
      {
        "provider": "github",
        "owner": "sourav123-4",
        "repo": "hisab-desktop-app"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "main.js",
      "google-auth.html",
      "preload.js",
      "preload.cjs",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.png",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "keywords": [
    "personal-finance",
    "expense-tracker",
    "hisab",
    "loans",
    "emi",
    "investments",
    "salary",
    "desktop-app"
  ],
  "author": {
    "name": "Sourav Mahanty",
    "email": "souravmahanty12@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "electron-updater": "^6.8.9",
    "firebase": "^12.17.0",
    "lucide": "^0.395.0",
    "papaparse": "^5.6.0"
  }
}
