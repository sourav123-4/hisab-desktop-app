{
  "name": "daily-hisab",
  "version": "1.0.0",
  "description": "Daily Hisab desktop app for expenses, investments, loans/EMIs, and salary tracking",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.dailyhisab.app",
    "productName": "Daily Hisab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "keywords": [
    "personal-finance",
    "expense-tracker",
    "hisab",
    "loans",
    "emi",
    "investments",
    "salary",
    "desktop-app"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.3.0"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "lucide": "^0.395.0"
  }
}
